    <node id="J10" x="300.0" y="0.0"   type="priority"/>
    <node id="J20" x="600.0" y="0.0"   type="priority"/>
    <node id="J30" x="900.0" y="0.0"   type="priority"/>

    <!-- Row 1 (Central Arterial Avenue) -->
    <node id="J01" x="0.0"   y="300.0" type="priority"/>
