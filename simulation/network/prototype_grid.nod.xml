    <node id="J21" x="600.0" y="300.0" type="traffic_light" tl="TL_J21"/>
    <node id="J31" x="900.0" y="300.0" type="priority"/>

    <!-- Row 2 (North Avenue) -->
    <node id="J02" x="0.0"   y="600.0" type="priority"/>
    <node id="J12" x="300.0" y="600.0" type="priority"/>
