-->
<tlLogics xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/tllogic_file.xsd">
    <tlLogic id="TL_J11" type="static" programID="0" offset="0">
        <!-- East-West Green -->
        <phase duration="31" state="GGgrrrGGgrrr"/>
        <!-- East-West Yellow -->
        <phase duration="4"  state="yyyrrryyyrrr"/>
        <!-- North-South Green -->
        <phase duration="25" state="rrrGGgrrrGGg"/>
        <!-- North-South Yellow -->
        <phase duration="4"  state="rrryyyrrryyy"/>
